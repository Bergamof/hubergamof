        "workMinutes": 25,
        "shortBreakMinutes": 5,
        "longBreakMinutes": 15,
        "longBreakEvery": 4,
        "autoStart": false
      }
    },
    {
      "id": "docker",
      "kind": "docker",
      "label": null,
      "image": null,
      "settings": {
        "composeFiles": [
          "~/projects/app/compose.yaml"
        ]
      }
    },
    {
      "id": "intellij",
      "kind": "intellij",
      "label": "IDE",
      "image": null,
      "settings": {
        "projectsDirectory": "~/projects"
      }
    },
    {
      "id": "claude",
      "kind": "claude",
      "label": null,
      "image": null,
      "settings": {}
    },
    {
      "id": "volume",
      "kind": "audio",
      "label": "Volume",
      "image": null,
      "settings": {
        "target": "defaultSink"
      }
    }
  ],
  "dials": [
    {
      "kind": "module",
      "instance": "volume",
      "function": "volume"
    },
    {
      "kind": "module",
      "instance": "pomodoro",
      "function": "control"
