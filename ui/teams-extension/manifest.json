{
	"manifest_version": 3,
	"name": "HuBergamof",
	"version": "0.1.0",
	"description": "Relaie à HuBergamof l'état de Teams (non lus, appel, calendrier) et ses commandes d'appel.",
	"key": "",
	"icons": { "48": "icons/hubergamof-48.png", "128": "icons/hubergamof-64.png" },
	"permissions": ["nativeMessaging", "alarms"],
	"host_permissions": ["https://teams.cloud.microsoft/*", "https://outlook.office.com/*"],
	"background": { "service_worker": "background.js", "type": "module" },
	"content_scripts": [
		{
			"matches": ["https://teams.cloud.microsoft/*", "https://outlook.office.com/*"],
			"js": ["content.js"],
			"run_at": "document_idle",
			"all_frames": true
		}
	],
	"web_accessible_resources": [
		{
			"resources": ["lib/*.js"],
			"matches": ["https://teams.cloud.microsoft/*", "https://outlook.office.com/*"],
			"use_dynamic_url": true
		}
	]
}
