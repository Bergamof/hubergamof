# HuBergamof — service systemd utilisateur (gabarit).
# Gabarit commun : packaging/install.sh (installation depuis les sources) et
# packaging/package/stage.sh (paquets .deb et Arch) remplacent, sur la ligne
# ExecStart, les jetons entre arobases par le chemin du binaire et le dossier de
# configuration (échappés pour une ligne ExecStart).
#
# Rattaché à la session graphique (modèle de systemd.special(7)) : le service
# démarre une fois que l'environnement de bureau a importé WAYLAND_DISPLAY/DISPLAY
# dans le gestionnaire utilisateur (nécessaires à xdg-open, ouverture de l'UI depuis
# le tray), et s'arrête avec la session. DBUS_SESSION_BUS_ADDRESS est fourni par
# systemd --user ; le tray se ré-enregistre si le StatusNotifierWatcher arrive après.

[Unit]
Description=HuBergamof Stream Deck manager
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=@BINARY@ --config-dir "@CONFIG_DIR@"
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
